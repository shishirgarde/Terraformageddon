# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]

# Auth (Phase 1: set to true to skip authentication)
AUTH_DISABLED=true

# Azure AD B2C (Phase 2: set AUTH_DISABLED=false and fill these in)
AZURE_TENANT_NAME=terraformageddon
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-backend-client-id
AZURE_B2C_FLOW=B2C_1_susi

# Database — Azure PostgreSQL Flexible Server (passwordless / AAD auth)
#
# This project uses Microsoft Entra (Azure AD) authentication only.
# No DB password is ever stored. Tokens are fetched at runtime via
# DefaultAzureCredential, which works for both:
#   - Managed Identity when running in Azure (system or user-assigned)
#   - `az login` developer credentials when running locally
#
# Prereqs on the PG server:
#   1. Enable Microsoft Entra authentication on the Flexible Server.
#   2. Add your AAD principal (user / MI / service principal) as a PG role.
#   3. Grant required privileges on the target database to that role.
#
DB_HOST=yourserver.postgres.database.azure.com
DB_PORT=5432
DB_NAME=dbname
# AAD principal name configured as a PG role.
# Examples:
#   - User:        alice@contoso.com
#   - System MI:   <app-service-name>   (the MI's display name)
#   - User MI:     <user-assigned-mi-name>
#   - SP:          <service-principal-display-name>
DB_USER=
DB_SSL_MODE=require

# Optional: only set when using a USER-ASSIGNED managed identity in Azure.
# Leave blank for system-assigned MI or for local `az login`.
AZURE_DB_CLIENT_ID=

# Optional escape hatch: provide a full async SQLAlchemy URL.
# When set, this overrides the DB_* fields above. Leave empty for AAD auth.
DATABASE_URL=

# Docker — backend runs natively; only sandboxes run in containers.
# WORKSPACE_BASE_DIR is a host path the backend writes to and bind-mounts
# into each sandbox container. On Windows, use a path like C:\tmp\tg-sessions.
SANDBOX_IMAGE=terraformageddon-sandbox:latest
SESSION_TIMEOUT_MINUTES=15
WORKSPACE_BASE_DIR=/tmp/tg-sessions

# Security
MAX_SESSIONS_PER_USER=3
MAX_RUNS_PER_MINUTE=30
MAX_WORKSPACE_SIZE_MB=50
